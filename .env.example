# =============================================================================
# Mecânicos Bike — Variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (Turso em produção / SQLite local)
# -----------------------------------------------------------------------------

# Para desenvolvimento local (SQLite):
DATABASE_URL="file:./prisma/database/database.sqlite"

# Para produção (Turso):
# DATABASE_URL="libsql://<nome-do-banco>.turso.io"
TURSO_DATABASE_URL="libsql://<nome-do-banco>.turso.io"
TURSO_AUTH_TOKEN="<token-de-autenticacao-do-turso>"

# -----------------------------------------------------------------------------
# Autenticação JWT
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo de 32 caracteres. O app recusa inicializar se for menor.
# -----------------------------------------------------------------------------
JWT_SECRET="TROQUE_POR_UM_SEGREDO_DE_64_CARACTERES_ALEATORIOS_AQUI_AGORA"

# -----------------------------------------------------------------------------
# Envio de e-mail via Resend (https://resend.com)
# Plano gratuito: 3.000 e-mails/mês, 100 por dia.
# Sem a chave, os links e códigos são impressos no console do servidor.
# -----------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Remetente dos e-mails.
# Sem domínio próprio verificado no Resend, use apenas: onboarding@resend.dev
# (funciona apenas para o e-mail dono da conta Resend — só para testes)
EMAIL_FROM="Mecânicos Bike <nao-responda@seudominio.com>"

# -----------------------------------------------------------------------------
# URL pública da aplicação (usada nos links de reset de senha nos e-mails)
# -----------------------------------------------------------------------------
APP_URL="https://mecanicos-bike.fly.dev"

# -----------------------------------------------------------------------------
# Conta demo (usada pelo script npm run db:seed)
# -----------------------------------------------------------------------------
DEMO_PASSWORD="TROQUE_POR_UMA_SENHA_FORTE_PARA_A_CONTA_DEMO"
